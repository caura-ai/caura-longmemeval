# Caura credentials & endpoint
CAURA_API_KEY=mc_your_key_here
CAURA_TENANT_ID=ten2-your_tenant_id
CAURA_BASE_URL=https://caura.ai/api/v1
CAURA_AGENT_PREFIX=lme

# Ingestion configuration
CAURA_INGEST=bulk
CAURA_CHUNK_CHARS=4000
CAURA_BULK_SIZE=25
CAURA_TOP_K=20
CAURA_MULTIQUERY=2
CAURA_MERGE_TOP_K=35
CAURA_SETTLE_TIME=8.0
CAURA_CATEGORY_ADAPTIVE=true

# Evaluation & Answer Generation LLM
GEMINI_API_KEY=your_gemini_api_key
READER_LLM=gemini
READER_MODEL=gemini-3.8-flash

# Judge protocol: gpt-4o primary = headline number (the LongMemEval reference judge, what published
# leaderboards use); gemini-3.5-flash-lite secondary = strict development judge (fails hedged answers).
# Both always run and are reported side by side. Never pick the judge after seeing the score.
OPENAI_API_KEY=your_openai_api_key
JUDGE_LLM=openai
JUDGE_MODEL=gpt-4o
SECONDARY_JUDGE_LLM=gemini
SECONDARY_JUDGE_MODEL=gemini-3.5-flash-lite
# Optional: reasoning effort for GPT-5.x judges/readers (none | low | medium | high)
# OPENAI_REASONING_EFFORT=low
